{
  "name": "personal-site-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Devin Davis Personal Site Monorepo",
  "author": "Devin",
  "scripts": {
    "develop": "pnpm --filter web develop",
    "start": "pnpm --filter web develop",
    "build": "pnpm --filter web build",
    "build:contracts": "pnpm --filter contracts compile",
    "serve": "pnpm --filter web serve",
    "clean": "pnpm --filter web clean",
    "test": "pnpm --filter web test",
    "test:contracts": "pnpm --filter contracts test",
    "test:e2e": "pnpm --filter web test:e2e",
    "biome:lint": "biome check .",
    "biome:fix": "biome check --write --unsafe .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
